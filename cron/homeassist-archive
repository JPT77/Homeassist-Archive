#!/bin/sh

set -eu

HOME_DIR=/opt/homeassist
BASE_DIR="$HOME_DIR"
APP_DIR="$BASE_DIR/Homeassist-Archive"
VENV="$BASE_DIR/.venv/bin/python"
LOG_DIR="$BASE_DIR/logs"
ENV_FILE="$BASE_DIR/postgres-login.env"

cd "$BASE_DIR"

mkdir -vp "$LOG_DIR"

# default values
export PG_USER="homeassist"
export PG_HOST="localhost"
#export PG_PW=""

# fetch actual values from env file
if [ ! -f "$ENV_FILE" ]; then
    echo "ERROR: Configuration file not found: $ENV_FILE" >&2
    exit 1
fi

set -a
. "$ENV_FILE"
set +a

LOG="$LOG_DIR/import-$(date '+%Y-%m-%d_%H-%M-%S').log"

exec "$VENV" "$APP_DIR/fetchhomeassist.py" >> "$LOG" 2>&1
